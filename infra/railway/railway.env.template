# Core app
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET
APP_NAME=VIC

# Public URLs (single-domain mode)
APP_URL=https://events.vidya.edu.in/app
APP_FRONTEND_URL=https://events.vidya.edu.in/app
CORS_ALLOWED_ORIGINS=https://events.vidya.edu.in

# Database (Supabase direct)
DB_CONNECTION=pgsql
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=REPLACE_WITH_SUPABASE_PASSWORD

# Mail (Brevo SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_BREVO_LOGIN_EMAIL
MAIL_PASSWORD=REPLACE_WITH_BREVO_SMTP_KEY
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=events@vidya.edu.in
MAIL_FROM_NAME="Team VIC"

# Runtime defaults
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
CACHE_DRIVER=array

# Frontend branding vars used by Hi.Events Vite app (set if available in your version)
VITE_APP_NAME=VIC
VITE_APP_LOGO_LIGHT=https://www.vidya.edu.in/images/VU.png
VITE_APP_LOGO_DARK=https://www.vidya.edu.in/images/VU.png
VITE_APP_PRIMARY_COLOR=#ffb703
VITE_APP_SECONDARY_COLOR=#2ec4b6
